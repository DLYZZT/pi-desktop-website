---
import { withBase } from "../utils/paths";

interface Props {
  name: string;
  alt: string;
  eager?: boolean;
}

const { name, alt, eager = false } = Astro.props;
const src = withBase(`screenshots/v0.4.0/${name}.png`);
const dimensions: Record<string, [number, number]> = {
  "app-main": [1915, 979], "app-models": [1914, 980], "app-mcp": [1917, 979],
  "app-browser": [1919, 977], "app-herdr": [1920, 981],
  "app-skill": [1916, 981], "app-dev-tools": [1917, 982],
};
const [width, height] = dimensions[name];
---

<figure class="product-screenshot">
  <a href={src} target="_blank" rel="noopener noreferrer" aria-label="Open full-size screenshot">
    <img src={src} alt={alt} width={width} height={height} loading={eager ? "eager" : "lazy"} decoding="async" />
  </a>
  <figcaption><span>{alt}</span><span class="screenshot-version" translate="no">v0.4.0</span></figcaption>
</figure>

<style>
  .product-screenshot { margin: 22px 0; overflow: hidden; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-panel); }
  a { display: block; cursor: zoom-in; }
  img { display: block; width: 100%; height: auto; }
  figcaption { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 12px 16px; color: var(--text-muted); font-size: 12px; }
  .screenshot-version { flex-shrink: 0; color: var(--text-dim); font-family: var(--font-mono); font-size: 11px; }
</style>
