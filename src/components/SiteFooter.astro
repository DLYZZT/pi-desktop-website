---
import { Icon } from "astro-icon/components";
import type { Locale } from "../i18n";
import { localizedPath } from "../i18n";
import { withBase } from "../utils/paths";

interface Props {
  lang?: Locale;
}

const { lang = "zh" } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src={withBase("icon.png")} alt="" width="26" height="26" />
          <span>Pi Agent Desktop</span>
        </div>
        <p class="footer-desc">{"A true desktop workspace for Pi Coding Agent. Local-first, no local server, and cross-platform."}</p>
        <div class="footer-socials" aria-label={"Social media"}>
          <a
            class="icon-btn"
            href="https://github.com/DLYZZT/pi-desktop"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={"GitHub repository"}
          >
            <Icon name="simple-icons:github" aria-hidden="true" />
          </a>
          <a
            class="icon-btn"
            href="https://x.com/dlyzzt"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={"Follow DLYZZT on X"}
          >
            <Icon name="simple-icons:x" aria-hidden="true" />
          </a>
        </div>
      </div>
      <div>
        <h5>{"Product"}</h5>
        <ul>
          <li><a href={localizedPath(lang, "download/")}>{"Download"}</a></li>
          <li><a href={localizedPath(lang, "changelog/")}>{"Changelog"}</a></li>
          <li><a href={`${localizedPath(lang, "docs/")}#requirements`}>{"System requirements"}</a></li>
        </ul>
      </div>
      <div>
        <h5>{"Resources"}</h5>
        <ul>
          <li><a href={localizedPath(lang, "docs/")}>{"Documentation"}</a></li>
          <li><a href="https://github.com/DLYZZT/pi-desktop" target="_blank" rel="noopener noreferrer">{"GitHub repository"}</a></li>
          <li><a href="https://x.com/dlyzzt" target="_blank" rel="noopener noreferrer">X / Twitter</a></li>
          <li><a href="https://github.com/DLYZZT/pi-desktop/releases" target="_blank" rel="noopener noreferrer">Releases</a></li>
        </ul>
      </div>
      <div>
        <h5>{"Development"}</h5>
        <ul>
          <li><a href="https://github.com/DLYZZT/pi-desktop/issues" target="_blank" rel="noopener noreferrer">Issues</a></li>
          <li><a href="https://github.com/DLYZZT/pi-desktop/pulls" target="_blank" rel="noopener noreferrer">Pull Requests</a></li>
          <li><a href="https://github.com/DLYZZT/pi-desktop/actions/workflows/build-desktop.yml" target="_blank" rel="noopener noreferrer">{"Build status"}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{"© 2026 DLYZZT · Open source under Apache License 2.0"}</span>
      <span data-version>v0.3.0</span>
    </div>
  </div>
</footer>
