---
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductScreenshot from "../ProductScreenshot.astro";
import { whatsNew } from "../../data/whats-new";
import { RELEASE_VERSION } from "../../data/release";
import AppPreview from "../../components/AppPreview.astro";
import { localizedPath } from "../../i18n";
import { withBase } from "../../utils/paths";

const features = [
  {
    icon: "ph:chats-circle",
    title: "A complete conversation experience",
    description: "Adjust chat text, conversation width, and model-reply width; attach any file and queue Steer or Follow-up messages while pagination and deferred content keep long conversations responsive.",
  },
  {
    icon: "ph:browser",
    title: "A browser shared with the Agent",
    description: "Open real Chromium pages on the right with multiple tabs, profiles, and login state. After separate authorization, the Agent can read and operate the same page.",
  },
  {
    icon: "ph:share-network",
    title: "Conversational Herdr Agent fleets",
    description: "Manage a local Agent fleet from the main conversation on macOS, Linux, and Windows x64, then observe, troubleshoot, or explicitly take keyboard control in the ANSI terminal.",
  },
  {
    icon: "ph:folder-simple",
    title: "A project-centered file experience",
    description: "Manage Git branches and worktrees, recognize local Markdown paths, and use rich file actions while syntax highlighting, Mermaid, and KaTeX remain stable inside complex lists.",
  },
  {
    icon: "ph:sliders-horizontal",
    title: "Models and extensions in one place",
    description: "Pi Coding Agent 1.1.0 is included, with API key and subscription sign-in, model configuration, Auto routing, and advanced runtime controls.",
  },
  {
    icon: "ph:wrench",
    title: "Cross-platform developer tools",
    description: "Discover and verify system tools, or install private Node.js, Python, Git, Bun, and common CLI runtimes on demand without changing the system PATH.",
  },
  {
    icon: "ph:paper-plane-tilt",
    title: "Messaging channels",
    description: "Connect WeChat, Telegram, and Feishu / Lark. Create a new Feishu / Lark bot through the official QR flow or connect an existing custom app.",
  },
  {
    icon: "ph:terminal-window",
    title: "Observable managed processes",
    description: "Let the Agent keep dev servers, watchers, and mock APIs running. Inspect state, readiness, and redacted logs, then stop, restart, or export logs from the right panel.",
  },
  {
    icon: "ph:shield-check",
    title: "Secure by default",
    description: "Renderer sandboxing, a strict CSP, and typed IPC contracts. The UI and control plane open no local ports; managed project services require explicit enablement.",
  },
];

const checks = [
  ["Local data", "Sessions and Pi configuration stay on your machine by default", "~/.pi/agent/"],
  ["No internal ports", "The UI and control plane open no local ports; user-started project services may listen on loopback"],
  ["Minimal exposure", "Renderer sandbox + strict CSP + controlled preload bridge"],
  ["Browser isolation", "Remote pages receive no application preload, Node.js, or main Renderer bridge"],
  ["Separate permissions", "Coding, Browser, Herdr, and managed-process capabilities never implicitly enable one another"],
  ["Runtimes off by default", "Herdr and managed processes provide lifecycle control, not a security sandbox"],
  ["Encrypted credentials", "Channel tokens are encrypted with Electron safeStorage and never returned to the Renderer"],
  ["Trusted updates", "Update settings are fixed in production builds and do not accept external update URLs"],
];
---

<BaseLayout
  title="Pi Agent Desktop — A true desktop workspace for Pi Coding Agent"
  description="A local-first Pi Coding Agent workspace with Auto model routing, MCP services, image generation, tool history, a shared browser, and messaging."
>
  <main id="main-content">
    <section class="hero">
      <div class="container">
        <a class="release-announcement" href="#whats-new"><span translate="no">v{RELEASE_VERSION}</span><span>Discover what’s new</span><Icon name="ph:arrow-right" aria-hidden="true" /></a>
        <img class="hero-icon" src={withBase("icon.png")} alt="Pi Agent Desktop icon" width="104" height="104" />
        <h1>Pi Coding Agent<br />Desktop Workspace</h1>
        <p class="hero-sub">Code, connect tools, and create images in one local-first workspace. Let Auto choose the model, and keep every tool call in view.</p>
        <div class="hero-tags" aria-label="Product highlights">
          <span class="chip"><Icon class="chip-dot" name="ph:circle-fill" aria-hidden="true" />Local-first</span>
          <span class="chip"><Icon class="chip-dot" name="ph:circle-fill" aria-hidden="true" />No internal server</span>
          <span class="chip"><Icon class="chip-dot" name="ph:circle-fill" aria-hidden="true" />Cross-platform</span>
        </div>
        <div class="hero-cta">
          <a class="btn btn-primary" data-hero-download href={localizedPath("en", "download/")}>
            <Icon name="ph:download-simple" aria-hidden="true" />
            <span data-hero-label>Download Pi Agent Desktop</span>
          </a>
          <a class="btn btn-secondary" href="https://github.com/DLYZZT/pi-desktop" target="_blank" rel="noopener noreferrer">
            <Icon name="simple-icons:github" aria-hidden="true" />
            GitHub
          </a>
        </div>
        <p class="hero-meta">
          Current version <span data-version>v{RELEASE_VERSION}</span><span class="dot">·</span>macOS, Windows, and Linux<span class="dot">·</span><a href={localizedPath("en", "changelog/")}>View changelog</a>
        </p>

        <AppPreview />
      </div>
    </section>

    <section class="section release-section" id="whats-new" aria-labelledby="whats-new-title">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">New in v0.4.0</p>
          <h2 class="section-title" id="whats-new-title">More capable. More in your control.</h2>
          <p class="section-desc">Connect your tools, route each task to the right model, and follow the work from request to result.</p>
        </div>
        <div class="release-grid">
          {whatsNew.map((feature) => (
            <article class="release-card">
              <div class="release-card-heading"><div class="feature-icon"><Icon name={feature.icon} aria-hidden="true" /></div><h3>{feature.title}</h3></div>
              <p>{feature.description}</p>
              {"screenshot" in feature && <ProductScreenshot name={feature.screenshot} alt={feature.title} />}
              <a class="release-guide-link" href={localizedPath("en", `docs/#${feature.id}`)}>Learn how to use it<Icon name="ph:arrow-right" aria-hidden="true" /></a>
            </article>
          ))}
        </div>
        <div class="release-more"><a href={localizedPath("en", "changelog/#v0-4-0")}>View changelog<Icon name="ph:arrow-right" aria-hidden="true" /></a></div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Features</p>
          <h2 class="section-title">A complete Agent workspace</h2>
          <p class="section-desc">From sessions, file previews, and a shared browser to Herdr Agent fleets, managed processes, models, extensions, and messaging, everyday work stays in one window.</p>
        </div>
        <div class="feature-grid">
          {features.map((feature) => (
            <article class="feature-card">
              <div class="feature-icon"><Icon name={feature.icon} aria-hidden="true" /></div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Channels</p>
          <h2 class="section-title">Keep the conversation going away from your desk</h2>
          <p class="section-desc">Connect WeChat, Telegram, or Feishu / Lark. Remote conversations use isolated sessions by default, or can share context with the current desktop session.</p>
        </div>
        <div class="channel-strip">
          <span class="channel-chip"><Icon class="channel-dot dot-wechat" name="ph:circle-fill" aria-hidden="true" />WeChat · QR sign-in</span>
          <span class="channel-chip"><Icon class="channel-dot dot-tg" name="ph:circle-fill" aria-hidden="true" />Telegram · Bot Token</span>
          <span class="channel-chip"><Icon class="channel-dot dot-lark" name="ph:circle-fill" aria-hidden="true" />Feishu / Lark · Official QR / Existing app</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Architecture</p>
          <h2 class="section-title">Three isolated processes, sandboxed web content</h2>
          <p class="section-desc">Privileged desktop capabilities, the Agent runtime, and the UI are isolated. Agent Host connects the Browser, managed processes, and local Herdr Sessions.</p>
        </div>
        <div class="arch-flow">
          <div class="arch-box"><h4>Main process</h4><p>Window · Tray · Updates<br />Browser Views and network policy</p></div>
          <div class="arch-box"><h4>Agent Host</h4><p>Pi Coding Agent in a utilityProcess<br />Browser · Processes · Herdr adapters</p></div>
          <div class="arch-box"><h4>Renderer</h4><p>React 19 UI<br />Controlled preload bridge</p></div>
          <div class="arch-box"><h4>Browser View</h4><p>Real Chromium pages<br />Sandbox · Profiles · Separate grants</p></div>
        </div>
        <div class="arch-note">
          <span class="chip">Typed MessagePort IPC</span>
          <span class="chip">Revisioned Browser RPC</span>
          <span class="chip">No control-plane ports</span>
          <span class="chip">POSIX groups / Windows Job Objects</span>
          <span class="chip">Herdr protocol 20</span>
          <span class="chip">Sessions and Pi settings in ~/.pi/agent/</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Privacy &amp; Security</p>
          <h2 class="section-title">Your data stays on your machine</h2>
          <p class="section-desc">Local-first is the default behavior, not a slogan.</p>
        </div>
        <div class="check-grid">
          {checks.map(([title, text, code]) => (
            <div class="check-item">
              <Icon name="ph:check" aria-hidden="true" />
              <span><b>{title}</b> — {text} {code && <code>{code}</code>}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="cta-panel">
          <h2>Ready to keep Pi Agent on your desktop?</h2>
          <p>Pi Coding Agent 1.1.0 is included. Install the app, configure a model provider, and start working.</p>
          <a class="btn btn-primary" href={localizedPath("en", "download/")}>
            <Icon name="ph:download-simple" aria-hidden="true" />
            Download free
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
