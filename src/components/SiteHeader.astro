---
import { Icon } from "astro-icon/components";
import { withBase } from "../utils/paths";

const pathname = Astro.url.pathname;
const navItems = [
  { href: withBase(), label: "首页" },
  { href: withBase("download/"), label: "下载" },
  { href: withBase("docs/"), label: "文档" },
  { href: withBase("changelog/"), label: "更新日志" },
];

const isCurrent = (href: string) => (href === withBase() ? pathname === href : pathname.startsWith(href));
---

<header class="nav">
  <div class="container nav-inner">
    <a class="nav-brand" href={withBase()}>
      <img src={withBase("icon.png")} alt="Pi Agent Desktop 图标" width="28" height="28" />
      <span>Pi Agent Desktop</span>
    </a>
    <nav class="nav-links" aria-label="主导航">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="切换深浅色主题">
        <Icon class="icon-moon" name="ph:moon" aria-hidden="true" />
        <Icon class="icon-sun" name="ph:sun" aria-hidden="true" />
      </button>
      <a
        class="icon-btn"
        href="https://github.com/DLYZZT/pi-desktop"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub 仓库"
      >
        <Icon name="simple-icons:github" aria-hidden="true" />
      </a>
    </div>
  </div>
</header>
