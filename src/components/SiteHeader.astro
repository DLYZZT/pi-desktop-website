---
import { Icon } from "astro-icon/components";
import type { Locale } from "../i18n";
import { alternateLocalePath, htmlLanguages, localeNames, locales, localizedPath } from "../i18n";
import { withBase } from "../utils/paths";

interface Props {
  lang?: Locale;
}

const { lang = "zh" } = Astro.props;
const pathname = Astro.url.pathname;
const navItems = [
  { href: localizedPath(lang), label: "Home" },
  { href: localizedPath(lang, "download/"), label: "Download" },
  { href: localizedPath(lang, "docs/"), label: "Docs" },
  { href: localizedPath(lang, "changelog/"), label: "Changelog" },
];

const homeHref = localizedPath(lang);
const isCurrent = (href: string) => (href === homeHref ? pathname === href : pathname.startsWith(href));
---

<header class="nav">
  <div class="container nav-inner">
    <a class="nav-brand" href={homeHref}>
      <img src={withBase("icon.png")} alt="Pi Agent Desktop icon" width="28" height="28" />
      <span>Pi Agent Desktop</span>
    </a>
    <nav class="nav-links" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <details class="language-menu" data-language-menu>
        <summary class="language-switch" aria-label="Choose language"><Icon name="ph:globe" aria-hidden="true" /><span>{localeNames[lang]}</span></summary>
        <div class="language-options" role="group" aria-label="Languages">
          {locales.map((locale) => (
            <a data-language-link href={alternateLocalePath(pathname, locale)} lang={htmlLanguages[locale]} hreflang={htmlLanguages[locale]} aria-current={locale === lang ? "page" : undefined}>{localeNames[locale]}</a>
          ))}
        </div>
      </details>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle color theme">
        <Icon class="icon-moon" name="ph:moon" aria-hidden="true" />
        <Icon class="icon-sun" name="ph:sun" aria-hidden="true" />
      </button>
      <a
        class="icon-btn"
        href="https://github.com/DLYZZT/pi-desktop"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
      >
        <Icon name="simple-icons:github" aria-hidden="true" />
      </a>
    </div>
  </div>
</header>
