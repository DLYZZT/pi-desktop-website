---
import { Icon } from "astro-icon/components";
import type { Locale } from "../i18n";
import { alternateLocalePath, localizedPath } from "../i18n";
import { withBase } from "../utils/paths";

interface Props {
  lang?: Locale;
}

const { lang = "zh" } = Astro.props;
const pathname = Astro.url.pathname;
const isEnglish = lang === "en";
const navItems = isEnglish
  ? [
      { href: localizedPath(lang), label: "Home" },
      { href: localizedPath(lang, "download/"), label: "Download" },
      { href: localizedPath(lang, "docs/"), label: "Docs" },
      { href: localizedPath(lang, "changelog/"), label: "Changelog" },
    ]
  : [
      { href: localizedPath(lang), label: "首页" },
      { href: localizedPath(lang, "download/"), label: "下载" },
      { href: localizedPath(lang, "docs/"), label: "文档" },
      { href: localizedPath(lang, "changelog/"), label: "更新日志" },
    ];

const homeHref = localizedPath(lang);
const isCurrent = (href: string) => (href === homeHref ? pathname === href : pathname.startsWith(href));
const languageHref = alternateLocalePath(pathname, isEnglish ? "zh" : "en");
---

<header class="nav">
  <div class="container nav-inner">
    <a class="nav-brand" href={homeHref}>
      <img src={withBase("icon.png")} alt={isEnglish ? "Pi Agent Desktop icon" : "Pi Agent Desktop 图标"} width="28" height="28" />
      <span>Pi Agent Desktop</span>
    </a>
    <nav class="nav-links" aria-label={isEnglish ? "Primary navigation" : "主导航"}>
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <a
        class="language-switch"
        href={languageHref}
        lang={isEnglish ? "zh-CN" : "en"}
        hreflang={isEnglish ? "zh-CN" : "en"}
        aria-label={isEnglish ? "Switch to Chinese" : "切换到英语"}
      >
        <Icon name="ph:globe" aria-hidden="true" />
        <span>{isEnglish ? "中文" : "EN"}</span>
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label={isEnglish ? "Toggle color theme" : "切换深浅色主题"}>
        <Icon class="icon-moon" name="ph:moon" aria-hidden="true" />
        <Icon class="icon-sun" name="ph:sun" aria-hidden="true" />
      </button>
      <a
        class="icon-btn"
        href="https://github.com/DLYZZT/pi-desktop"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={isEnglish ? "GitHub repository" : "GitHub 仓库"}
      >
        <Icon name="simple-icons:github" aria-hidden="true" />
      </a>
    </div>
  </div>
</header>
