---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import AppPreview from "../components/AppPreview.astro";
import { withBase } from "../utils/paths";

const features = [
  {
    icon: "ph:chats-circle",
    title: "完整的会话体验",
    description:
      "创建、搜索、按日期分组管理会话；增量索引、历史分页与延迟内容让大量会话和超长对话依然保持流畅。",
  },
  {
    icon: "ph:browser",
    title: "用户与 Agent 共享浏览器",
    description:
      "在右侧打开真实 Chromium 页面，保留多标签页、Profile 与登录态；Agent 经独立授权后可读取和操作同一个页面。",
  },
  {
    icon: "ph:folder-simple",
    title: "围绕项目的文件体验",
    description:
      "原生选择项目目录，管理 Git 分支与 Worktree；Markdown、代码高亮、Mermaid、KaTeX 与 Word 文档预览一应俱全。",
  },
  {
    icon: "ph:sliders-horizontal",
    title: "模型与扩展统一管理",
    description:
      "内置 Pi Coding Agent 0.84；按服务商搜索并控制模型显示范围，支持逐个或批量启用，模型设置与连接流程完整中文化。",
  },
  {
    icon: "ph:wrench",
    title: "跨平台开发工具",
    description:
      "发现并验证系统工具，也可按需安装应用私有的 Node.js、Python、Git、Bun 与常用 CLI，不修改系统 PATH。",
  },
  {
    icon: "ph:paper-plane-tilt",
    title: "IM 消息渠道",
    description:
      "个人微信、Telegram 与飞书 / Lark 接入；飞书 / Lark 可通过官方扫码创建机器人，也可连接已有自建应用。",
  },
  {
    icon: "ph:clock-clockwise",
    title: "为长期运行而设计",
    description:
      "单实例、系统托盘、桌面通知与角标，窗口状态记忆、系统主题跟随，Agent Host 崩溃自动恢复与诊断信息导出。",
  },
  {
    icon: "ph:shield-check",
    title: "安全默认开启",
    description:
      "Renderer sandbox、严格 CSP 与类型化 IPC 契约；不监听任何本地端口，会话与配置始终留在本机。",
  },
];

const checks = [
  ["数据本地留存", "会话与 Pi 配置默认保存在本机", "~/.pi/agent/"],
  ["零本地端口", "UI 通信不额外开放任何本地网络端口"],
  ["最小暴露面", "Renderer sandbox + 严格 CSP + 受控 preload 桥接"],
  ["浏览器隔离", "远程网页不获得应用 preload、Node 或主 Renderer bridge"],
  ["权限相互独立", "Coding 权限不会隐式开启 Browser read / interact"],
  ["凭证加密", "渠道 token 由 Electron safeStorage 加密，不回传 Renderer"],
  ["可信更新", "更新配置固定于正式包内，不接收外部更新地址"],
];
---

<BaseLayout
  title="Pi Agent Desktop — 把 Pi Coding Agent 变成真正的桌面工作台"
  description="Pi Agent Desktop 是 Pi Coding Agent 的本地优先桌面工作台，集成会话、项目文件、共享浏览器、模型、扩展与消息渠道，支持 macOS、Windows 与 Linux。"
>
  <main id="main-content">
    <section class="hero">
      <div class="container">
        <img class="hero-icon" src={withBase("icon.png")} alt="Pi Agent Desktop 图标" width="104" height="104" />
        <h1>Pi Coding Agent <br />桌面工作台</h1>
        <p class="hero-sub">会话、文件、共享浏览器、模型与消息渠道，统一收进一个本地优先的桌面应用。无需命令行，安装即用。</p>
        <div class="hero-tags" aria-label="产品特点">
          <span class="chip"><Icon class="chip-dot" name="ph:circle-fill" aria-hidden="true" />本地优先</span>
          <span class="chip"><Icon class="chip-dot" name="ph:circle-fill" aria-hidden="true" />零本地服务器</span>
          <span class="chip"><Icon class="chip-dot" name="ph:circle-fill" aria-hidden="true" />跨平台应用</span>
        </div>
        <div class="hero-cta">
          <a class="btn btn-primary" data-hero-download href="https://github.com/DLYZZT/pi-desktop/releases">
            <Icon name="ph:download-simple" aria-hidden="true" />
            <span data-hero-label>下载 Pi Agent Desktop</span>
          </a>
          <a class="btn btn-secondary" href="https://github.com/DLYZZT/pi-desktop" target="_blank" rel="noopener noreferrer">
            <Icon name="simple-icons:github" aria-hidden="true" />
            GitHub
          </a>
        </div>
        <p class="hero-meta">
          当前版本 <span data-version>v0.1.7</span><span class="dot">·</span>支持 macOS、Windows 与 Linux<span class="dot">·</span><a href={withBase("changelog/")}>查看更新日志</a>
        </p>

        <AppPreview />
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Features</p>
          <h2 class="section-title">一个完整的 Agent 工作台</h2>
          <p class="section-desc">从会话管理、文件预览和共享浏览器，到模型、扩展与消息渠道，桌面端把日常工作所需的一切收进同一个窗口。</p>
        </div>
        <div class="feature-grid">
          {
            features.map((feature) => (
              <article class="feature-card">
                <div class="feature-icon"><Icon name={feature.icon} aria-hidden="true" /></div>
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Channels</p>
          <h2 class="section-title">不在电脑前，也能继续对话</h2>
          <p class="section-desc">绑定微信、Telegram 或飞书 / Lark 后，外部对话默认使用独立会话，也可以与当前窗口共用上下文。</p>
        </div>
        <div class="channel-strip">
          <span class="channel-chip"><Icon class="channel-dot dot-wechat" name="ph:circle-fill" aria-hidden="true" />个人微信 · 二维码登录</span>
          <span class="channel-chip"><Icon class="channel-dot dot-tg" name="ph:circle-fill" aria-hidden="true" />Telegram · Bot Token</span>
          <span class="channel-chip"><Icon class="channel-dot dot-lark" name="ph:circle-fill" aria-hidden="true" />飞书 / Lark · 官方扫码 / 已有应用</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Architecture</p>
          <h2 class="section-title">三进程隔离，网页独立承载</h2>
          <p class="section-desc">高权限桌面能力、Agent 运行时和 UI 相互隔离；远程网页由 Main 创建的沙箱化 Browser View 承载。</p>
        </div>
        <div class="arch-flow">
          <div class="arch-box">
            <h4>Main 主进程</h4>
            <p>窗口 · 托盘 · 更新<br />Browser View 与网络策略</p>
          </div>
          <div class="arch-box">
            <h4>Agent Host</h4>
            <p>utilityProcess 中运行<br />Pi Coding Agent</p>
          </div>
          <div class="arch-box">
            <h4>Renderer</h4>
            <p>React 19 UI<br />受控 preload 桥接</p>
          </div>
          <div class="arch-box">
            <h4>Browser View</h4>
            <p>真实 Chromium 页面<br />沙箱 · Profile · 独立授权</p>
          </div>
        </div>
        <div class="arch-note">
          <span class="chip">类型化 MessagePort IPC</span>
          <span class="chip">revisioned Browser RPC</span>
          <span class="chip">零本地端口</span>
          <span class="chip">数据留在 ~/.pi/agent/</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Privacy &amp; Security</p>
          <h2 class="section-title">你的数据，留在你的机器上</h2>
          <p class="section-desc">本地优先不是口号，而是默认行为。</p>
        </div>
        <div class="check-grid">
          {
            checks.map(([title, text, code]) => (
              <div class="check-item">
                <Icon name="ph:check" aria-hidden="true" />
                <span>
                  <b>{title}</b> — {text} {code && <code>{code}</code>}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="cta-panel">
          <h2>准备好让 Pi Agent 常驻桌面了吗？</h2>
          <p>内置 Pi Coding Agent 0.84.0 运行时，安装并配置模型提供商后即可使用。</p>
          <a class="btn btn-primary" href={withBase("download/")}>
            <Icon name="ph:download-simple" aria-hidden="true" />
            免费下载
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
