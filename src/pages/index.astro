---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import AppPreview from "../components/AppPreview.astro";
import { withBase } from "../utils/paths";

const features = [
  {
    icon: "ph:chats-circle",
    title: "完整的会话体验",
    description:
      "支持聊天字号、对话宽度与模型回复宽度调整，任意文件附件和 Steer / Follow-up；长会话分页、滚动跟随与延迟内容保持流畅。",
  },
  {
    icon: "ph:browser",
    title: "用户与 Agent 共享浏览器",
    description:
      "在右侧打开真实 Chromium 页面，保留多标签页、Profile 与登录态；Agent 经独立授权后可读取和操作同一个页面。",
  },
  {
    icon: "ph:share-network",
    title: "对话式 Herdr Agent 舰队",
    description:
      "在主对话中管理本机 Agent 舰队；支持 12 种 Agent CLI，正式包可发现常见安装位置，右侧 ANSI 终端可观察、排查和接管。",
  },
  {
    icon: "ph:folder-simple",
    title: "围绕项目的文件体验",
    description:
      "管理 Git 分支与 Worktree，识别 Markdown 本地路径并提供文件操作；代码高亮、Mermaid 与 KaTeX 公式在复杂列表中也能稳定显示。",
  },
  {
    icon: "ph:sliders-horizontal",
    title: "模型与扩展统一管理",
    description:
      "内置 Pi Coding Agent 0.85；支持服务商 Base URL、模型显示范围与可靠刷新，应用界面和原生菜单提供英文、简体中文和繁体中文。",
  },
  {
    icon: "ph:wrench",
    title: "跨平台开发工具",
    description:
      "发现并验证系统工具，也可按需安装应用私有的 Node.js、Python、Git、Bun 与常用 CLI，不修改系统 PATH。",
  },
  {
    icon: "ph:paper-plane-tilt",
    title: "IM 消息渠道",
    description:
      "个人微信、Telegram 与飞书 / Lark 接入；飞书 / Lark 可通过官方扫码创建机器人，也可连接已有自建应用。",
  },
  {
    icon: "ph:terminal-window",
    title: "可观察的受管进程",
    description:
      "让 Agent 持续运行开发服务器、watcher 与 mock API；在右侧查看状态、readiness 和脱敏日志，并可停止、重启或导出日志。",
  },
  {
    icon: "ph:shield-check",
    title: "安全默认开启",
    description:
      "Renderer sandbox、严格 CSP 与类型化 IPC 契约；UI 和控制面不监听本地端口，受管项目服务需要显式开启。",
  },
];

const checks = [
  ["数据本地留存", "会话与 Pi 配置默认保存在本机", "~/.pi/agent/"],
  ["零内部端口", "UI 与控制面不额外开放本地端口；用户启动的项目服务可监听 loopback"],
  ["最小暴露面", "Renderer sandbox + 严格 CSP + 受控 preload 桥接"],
  ["浏览器隔离", "远程网页不获得应用 preload、Node 或主 Renderer bridge"],
  ["权限相互独立", "Coding、Browser、Herdr 与受管进程能力不会相互隐式授权"],
  ["运行时默认关闭", "Herdr 与受管进程提供生命周期控制，但都不是安全沙箱"],
  ["凭证加密", "渠道 token 由 Electron safeStorage 加密，不回传 Renderer"],
  ["可信更新", "更新配置固定于正式包内，不接收外部更新地址"],
];
---

<BaseLayout
  title="Pi Agent Desktop — 把 Pi Coding Agent 变成真正的桌面工作台"
  description="Pi Agent Desktop 是 Pi Coding Agent 的本地优先桌面工作台，集成会话、项目文件、共享浏览器、Herdr Agent 舰队、受管进程、模型、扩展与消息渠道。"
>
  <main id="main-content">
    <section class="hero">
      <div class="container">
        <img class="hero-icon" src={withBase("icon.png")} alt="Pi Agent Desktop 图标" width="104" height="104" />
        <h1>Pi Coding Agent <br />桌面工作台</h1>
        <p class="hero-sub">会话、文件、共享浏览器、Herdr Agent 舰队、受管进程、模型与消息渠道，统一收进一个本地优先的桌面应用。</p>
        <div class="hero-tags" aria-label="产品特点">
          <span class="chip"><Icon class="chip-dot" name="ph:circle-fill" aria-hidden="true" />本地优先</span>
          <span class="chip"><Icon class="chip-dot" name="ph:circle-fill" aria-hidden="true" />零内部服务器</span>
          <span class="chip"><Icon class="chip-dot" name="ph:circle-fill" aria-hidden="true" />跨平台应用</span>
        </div>
        <div class="hero-cta">
          <a class="btn btn-primary" data-hero-download href="https://github.com/DLYZZT/pi-desktop/releases">
            <Icon name="ph:download-simple" aria-hidden="true" />
            <span data-hero-label>下载 Pi Agent Desktop</span>
          </a>
          <a class="btn btn-secondary" href="https://github.com/DLYZZT/pi-desktop" target="_blank" rel="noopener noreferrer">
            <Icon name="simple-icons:github" aria-hidden="true" />
            GitHub
          </a>
        </div>
        <p class="hero-meta">
          当前版本 <span data-version>v0.2.3</span><span class="dot">·</span>支持 macOS、Windows 与 Linux<span class="dot">·</span><a href={withBase("changelog/")}>查看更新日志</a>
        </p>

        <AppPreview />
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Features</p>
          <h2 class="section-title">一个完整的 Agent 工作台</h2>
          <p class="section-desc">从会话管理、文件预览和共享浏览器，到 Herdr Agent 舰队、受管进程、模型、扩展与消息渠道，日常工作都在同一个窗口完成。</p>
        </div>
        <div class="feature-grid">
          {
            features.map((feature) => (
              <article class="feature-card">
                <div class="feature-icon"><Icon name={feature.icon} aria-hidden="true" /></div>
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Channels</p>
          <h2 class="section-title">不在电脑前，也能继续对话</h2>
          <p class="section-desc">绑定微信、Telegram 或飞书 / Lark 后，外部对话默认使用独立会话，也可以与当前窗口共用上下文。</p>
        </div>
        <div class="channel-strip">
          <span class="channel-chip"><Icon class="channel-dot dot-wechat" name="ph:circle-fill" aria-hidden="true" />个人微信 · 二维码登录</span>
          <span class="channel-chip"><Icon class="channel-dot dot-tg" name="ph:circle-fill" aria-hidden="true" />Telegram · Bot Token</span>
          <span class="channel-chip"><Icon class="channel-dot dot-lark" name="ph:circle-fill" aria-hidden="true" />飞书 / Lark · 官方扫码 / 已有应用</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Architecture</p>
          <h2 class="section-title">三进程隔离，网页独立承载</h2>
          <p class="section-desc">高权限桌面能力、Agent 运行时和 UI 相互隔离；Agent Host 统一衔接 Browser、受管进程与本机 Herdr Session。</p>
        </div>
        <div class="arch-flow">
          <div class="arch-box">
            <h4>Main 主进程</h4>
            <p>窗口 · 托盘 · 更新<br />Browser View 与网络策略</p>
          </div>
          <div class="arch-box">
            <h4>Agent Host</h4>
            <p>utilityProcess 中运行 Pi Coding Agent<br />Browser · Processes · Herdr 适配器</p>
          </div>
          <div class="arch-box">
            <h4>Renderer</h4>
            <p>React 19 UI<br />受控 preload 桥接</p>
          </div>
          <div class="arch-box">
            <h4>Browser View</h4>
            <p>真实 Chromium 页面<br />沙箱 · Profile · 独立授权</p>
          </div>
        </div>
        <div class="arch-note">
          <span class="chip">类型化 MessagePort IPC</span>
          <span class="chip">revisioned Browser RPC</span>
          <span class="chip">控制面零本地端口</span>
          <span class="chip">POSIX group / Windows Job Object</span>
          <span class="chip">Herdr protocol 20</span>
          <span class="chip">数据留在 ~/.pi/agent/</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <p class="eyebrow">Privacy &amp; Security</p>
          <h2 class="section-title">你的数据，留在你的机器上</h2>
          <p class="section-desc">本地优先不是口号，而是默认行为。</p>
        </div>
        <div class="check-grid">
          {
            checks.map(([title, text, code]) => (
              <div class="check-item">
                <Icon name="ph:check" aria-hidden="true" />
                <span>
                  <b>{title}</b> — {text} {code && <code>{code}</code>}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="cta-panel">
          <h2>准备好让 Pi Agent 常驻桌面了吗？</h2>
          <p>内置 Pi Coding Agent 0.85.0 运行时，安装并配置模型提供商后即可使用。</p>
          <a class="btn btn-primary" href={withBase("download/")}>
            <Icon name="ph:download-simple" aria-hidden="true" />
            免费下载
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
