---
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-mono";
import "../styles/site.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { htmlLanguages, localizedPath, localeFromPathname, localeRouteFromPathname, locales } from "../i18n";
import { withBase } from "../utils/paths";
import { clientPhrases } from "../i18n/client";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang = localeFromPathname(Astro.url.pathname);
const iconUrl = withBase("icon.png");
const routePath = localeRouteFromPathname(Astro.url.pathname);
const absoluteUrl = (path: string) => Astro.site ? new URL(path, Astro.site).toString() : path;
const currentPath = localizedPath(lang, routePath);
const documentLang = htmlLanguages[lang];
const skipLabel = "Skip to main content";
const heroBackgrounds = [
  `--hero-grid-image: url('${withBase("hero-grid.webp")}')`,
  `--hero-grid-dark-image: url('${withBase("hero-grid-dark.webp")}')`,
  `--hero-fade-image: url('${withBase("hero-fade.webp")}')`,
  `--hero-fade-dark-image: url('${withBase("hero-fade-dark.webp")}')`,
].join(";");
---

<!doctype html>
<html lang={documentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f6f3" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl(currentPath)} />
    {locales.map((locale) => <link rel="alternate" hreflang={htmlLanguages[locale]} href={absoluteUrl(localizedPath(locale, routePath))} />)}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizedPath("zh", routePath))} />
    <link rel="icon" type="image/png" href={iconUrl} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("pi-site-theme");
          const dark = saved === "dark" || (!saved && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.dataset.theme = dark ? "dark" : "light";
        } catch {}
      })();
    </script>
  </head>
  <body style={heroBackgrounds}>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <SiteHeader lang={lang} />
    <slot />
    <SiteFooter lang={lang} />
    <div hidden id="client-i18n" aria-hidden="true">
      {Object.entries(clientPhrases).map(([key, phrase]) => <span data-client-message={key}>{phrase}</span>)}
    </div>
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
