---
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-mono";
import "../styles/site.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { Locale } from "../i18n";
import { localizedPath, localeRouteFromPathname } from "../i18n";
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  description: string;
  lang?: Locale;
}

const { title, description, lang = "zh" } = Astro.props;
const iconUrl = withBase("icon.png");
const routePath = localeRouteFromPathname(Astro.url.pathname);
const zhPath = localizedPath("zh", routePath);
const enPath = localizedPath("en", routePath);
const absoluteUrl = (path: string) => Astro.site ? new URL(path, Astro.site).toString() : path;
const currentPath = lang === "en" ? enPath : zhPath;
const documentLang = lang === "en" ? "en" : "zh-CN";
const skipLabel = lang === "en" ? "Skip to main content" : "跳到主要内容";
const heroBackgrounds = [
  `--hero-grid-image: url('${withBase("hero-grid.webp")}')`,
  `--hero-grid-dark-image: url('${withBase("hero-grid-dark.webp")}')`,
  `--hero-fade-image: url('${withBase("hero-fade.webp")}')`,
  `--hero-fade-dark-image: url('${withBase("hero-fade-dark.webp")}')`,
].join(";");
---

<!doctype html>
<html lang={documentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f6f3" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl(currentPath)} />
    <link rel="alternate" hreflang="zh-CN" href={absoluteUrl(zhPath)} />
    <link rel="alternate" hreflang="en" href={absoluteUrl(enPath)} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(zhPath)} />
    <link rel="icon" type="image/png" href={iconUrl} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("pi-site-theme");
          const dark = saved === "dark" || (!saved && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.dataset.theme = dark ? "dark" : "light";
        } catch {}
      })();
    </script>
  </head>
  <body style={heroBackgrounds}>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <SiteHeader lang={lang} />
    <slot />
    <SiteFooter lang={lang} />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
